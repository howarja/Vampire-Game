[sub_resource type="Resource" id="Resource_lw0dh"]
script = ExtResource("1_tr7q8")
prompt = "Where do you live?"
answer = Array[String](["So if you imagine this in your head right.", "Begin from the sign between barker and main then walk down to the right of barkers street.", "You will see a small alley, go down that take a right and then a left.", "Then you have arived in a little garden, go to the biggest building there in the blue bricks.", "Do you follow so far?", "Right, then you walk up the stairs to floor 3 and go down the broken elevator shaft.", "There is a removable panel.", "Follow the vent down to the part where it starts to stink of rot.", "You then have to drop down to the second floor and jump the spike pit.", "Afterwards you follow the yellow brick road.", "And then you look to your left in front of the second bridge, where you will find a shack.", "In this shack there will be a compas of gold and you can use it find a cave.", "In that cave there is a trap door that leads to a basement.", "In that basement behind an invisible wall is a small room and thats where I have been camping out. ", "Makes sense?", "Hope not because thats all made up, I live at 61 jumpers lane."])
audio = Array[AudioStreamWAV]([ExtResource("10_mvpxy"), ExtResource("11_4dukv"), ExtResource("12_8wiav"), ExtResource("13_2de3n"), ExtResource("14_f1uly"), ExtResource("15_vgfq2"), ExtResource("16_wy7jn"), ExtResource("17_c8bu5"), ExtResource("18_dstqq"), ExtResource("19_lh0rc"), ExtResource("20_atppv"), ExtResource("21_dv274"), ExtResource("22_a5m7l"), ExtResource("23_7xks4"), ExtResource("24_7se0l"), ExtResource("25_3l21i")])
metadata/_custom_type_script = "uid://bsj2rcs7yvbxy"

